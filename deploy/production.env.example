# Copiar como production.env en la carpeta del proyecto en el servidor (NO se sube a GitHub).
# DB_PASSWORD debe ser igual a MARIADB_PASSWORD de db.env.
APP_NAME=SIDEc
APP_ENV=production
APP_KEY=
